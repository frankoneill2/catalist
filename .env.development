# Development Firebase project (catalist-dev) — used by `npm run dev`.
#
# These values are not secret. Firebase web config is intentionally public; security
# comes from Firestore rules and Auth, not from hiding these strings.
#
# Switch deploy targets with `firebase use dev` / `firebase use default`.

VITE_FIREBASE_API_KEY=AIzaSyDBE5shFBiRNb0o7c8zfmXVl3nR0xROO6c
VITE_FIREBASE_AUTH_DOMAIN=catalist-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=catalist-dev
VITE_FIREBASE_STORAGE_BUCKET=catalist-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=354871411208
VITE_FIREBASE_APP_ID=1:354871411208:web:abf9529819a0752beac7bd

# Sentry — set VITE_SENTRY_DSN to a real DSN in `.env.development.local` once you
# create the dev Sentry project. Left blank here so dev runs don't ship events.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Phase 5 envelope encryption — KEK seed shipped with the bundle. Falls back to
# a hard-coded constant if unset. Production should set this in
# `.env.production.local`. The longer-term plan is to move the KEK behind a
# Cloud Function backed by Cloud KMS (see docs/security-rebuild-plan.md
# Phase 5 / Phase 7) so it's never bundle-shipped at all.
VITE_FIELD_KEK_SEED=

# Phase 8 App Check — reCAPTCHA v3 site key. Leave blank in dev (no enforcement
# applied to catalist-dev). Production reads from `.env.production.local`.
VITE_APP_CHECK_RECAPTCHA_KEY=
