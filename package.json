{
  "name": "catalist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "deploy:dev": "npm run build:dev && firebase deploy --only hosting --project catalist-dev",
    "deploy:prod": "npm run build && firebase deploy --only hosting --project catalist-1",
    "rules:check": "bash scripts/check-rules-parity.sh",
    "backup:prod": "node scripts/backup-firestore.mjs --project catalist-1 --out backups",
    "backup:dev": "node scripts/backup-firestore.mjs --project catalist-dev --out backups"
  },
  "dependencies": {
    "@sentry/browser": "^10.51.0",
    "firebase": "^11.10.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4",
    "vite": "^5.3.4"
  }
}
