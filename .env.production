# Production Firebase project (catalist-1) — used by `npm run build`.
# These values are not secret. Firebase web config is intentionally public; security
# comes from Firestore rules and Auth restrictions, not from hiding these strings.
VITE_FIREBASE_API_KEY=AIzaSyBo5a6Uxk1vJwS8WqFnccjSnNOOXreOhcg
VITE_FIREBASE_AUTH_DOMAIN=catalist-1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=catalist-1
VITE_FIREBASE_STORAGE_BUCKET=catalist-1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=843924921323
VITE_FIREBASE_APP_ID=1:843924921323:web:0e7a847f8cd70db55f57ae
VITE_FIREBASE_MEASUREMENT_ID=G-6NZEC4ED4C

# Sentry — set VITE_SENTRY_DSN to the production Sentry project DSN. Leave blank
# (or unset) to skip error reporting. Recommend storing in `.env.production.local`
# once a real DSN exists; the placeholder here keeps the build happy.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Phase 5 envelope encryption — KEK seed for production builds. Override in
# `.env.production.local` with 32 bytes of high-entropy text once the dev
# evaluation is finished. Long-term: move behind Cloud Function + KMS.
VITE_FIELD_KEK_SEED=

# Phase 8 App Check — reCAPTCHA v3 site key. Set in `.env.production.local`
# after creating the key in Firebase Console → App Check. Soft-launch first
# (clients carry the key) before flipping enforcement on Firestore + Functions.
VITE_APP_CHECK_RECAPTCHA_KEY=
